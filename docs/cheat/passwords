# UUID
uuidgen                 # UUIDv4
uuidgen | tr -d '-'     # Только hex без дефисов

# TOKEN
openssl rand -hex 20     # (40 hex)
openssl rand -hex 32     # 256-bit ключ (32 байта) в hex
openssl rand -base64 32  # 256-bit в base64
openssl rand -hex 64     # Для HMAC (SHA256)
