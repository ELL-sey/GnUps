===============================================
                    Пароли
===============================================
# Обычный
openssl rand -base64 16 | tr -d '/+=' | cut -c1-20
cat /dev/urandom | tr -dc 'a-zA-Z0-9' | fold -w 32 | head -n 1
pwgen -sB 16 1
gpg --gen-random --armor 1 16

# + спец
openssl rand -base64 12
openssl rand -hex 16
cat /dev/urandom | tr -dc 'A-Za-z0-9!@#$%^&*()_+-=' | fold -w 32 | head -n 1
pwgen -syB 16 1

# словарные
apg -n 1 -m 16 -x 20


