Bash условия

# синтаксис if
if [ условие ]; then
    # действие
elif [ другое_условие ]; then
    # действие
else
    # действие
fi

## Проверка файлов и директорий
[ -f "/path/to/file" ]       # Существует ли файл
[ -d "/path/to/dir" ]        # Существует ли директория
[ -e "/path/to/file" ]       # Существует ли (файл или директория)
[ -r "/path/to/file" ]       # Доступен ли для чтения
[ -w "/path/to/file" ]       # Доступен ли для записи
[ -x "/path/to/file" ]       # Исполняемый ли файл
[ -s "/path/to/file" ]       # Не пустой ли файл
[ -L "/path/to/file" ]       # Является ли символической ссылкой

## Сравнение строк
[ "$str1" = "$str2" ]        # Равны ли строки
[ "$str1" != "$str2" ]       # Не равны ли строки
[ -z "$str" ]                # Пустая ли строка
[ -n "$str" ]                # Не пустая ли строка
[ "$str1" < "$str2" ]        # Лексикографически меньше
[ "$str1" > "$str2" ]        # Лексикографически больше
[[ "$str" == *"pattern"* ]]  # Содержит ли подстроку
[[ "$str" =~ ^[0-9]+$ ]]     # Соответствует ли регулярному выражению

## Сравнение чисел
[ "$num1" -eq "$num2" ]   # Равно (equal)
[ "$num1" -ne "$num2" ]   # Не равно (not equal)
[ "$num1" -gt "$num2" ]   # Больше (greater than)
[ "$num1" -ge "$num2" ]   # Больше или равно
[ "$num1" -lt "$num2" ]   # Меньше (less than)
[ "$num1" -le "$num2" ]   # Меньше или равно

## Логические операторы
[ условие1 ] && [ условие2 ]   # AND
[ условие1 ] || [ условие2 ]   # OR
! [ условие ]                  # NOT

# В двойных квадратных скобках:
[[ условие1 && условие2 ]]    # И
[[ условие1 || условие2 ]]    # ИЛИ
[[ ! условие ]]               # НЕ

## Проверка переменных
[ -v VAR ]                # Объявлена ли переменная
[ -n "${VAR+x}" ]         # Установлена ли переменная
[ -z "${VAR:-}" ]         # Пустая или не установлена

## Проверка команд и процессов
command -v cmd >/dev/null 2>&1    # Существует ли команда
which cmd >/dev/null 2>&1         # Найти путь к команде

## Проверка кода выхода команды
if command; then
    # команда выполнилась успешно (код 0)
else
    # команда вернула код != 0
fi
# Или
command && echo "Успешно" || echo "Ошибка"

## Проверка количества аргументов
[ $# -eq 0 ]              # Нет аргументов
[ $# -gt 0 ]              # Есть аргументы
[ $# -ge 1 ]              # Как минимум один аргумент

## Проверка, является ли переменная числом
[[ "$var" =~ ^-[0-9]+$ ]]           # Целое число
[[ "$var" =~ ^-[0-9]+\.[0-9]*$ ]]   # Число (с плавающей точкой)
