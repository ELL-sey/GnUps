# cron: Планировщик задач

# ┌───────────── минута (0 - 59)
# │ ┌───────────── час (0 - 23)
# │ │ ┌───────────── день месяца (1 - 31)
# │ │ │ ┌───────────── месяц (1 - 12)
# │ │ │ │ ┌───────────── день недели (0 - 6, 0 = воскресенье)
# │ │ │ │ │
# * * * * * команда_для_выполнения

## Строками
@reboot     # При загрузке системы (один раз)
@yearly     # Ежегодно (0 0 1 1 *)
@monthly    # Ежемесячно (0 0 1 * *)
@weekly     # Еженедельно (0 0 * * 0)
@daily      # Ежедневно (0 0 * * *)
@hourly     # Ежечасно (0 * * * *)
@minutely   # Каждую минуту (* * * * *)

## Спец символы
*     # Любое значение (каждую минуту, каждый час и т.д.)
,     # Список значений (1,3,5)
-     # Диапазон значений (1-5)
/     # Шаг (*/5 = каждые 5 единиц)
L     # Последний день месяца/недели (3L = последняя среда)
W     # Ближайший рабочий день (15W = ближайший рабочий день к 15-му)
#     # N-й день недели в месяце (3#2 = вторая среда)
?     # Не указано (для дня недели или дня месяца) что значит

## ПРИМЕРЫ

# Каждый день в 02:30:
30 2 * * *

# Каждую неделю в понедельник в 03:00:
0 3 * * 1

# Каждый месяц 1-го числа в 04:00:
0 4 1 * *

# Каждый год 1-го января в 05:00:
0 5 1 1 *

# Каждые 5 минут:
*/5 * * * *

# Каждые 2 часа:
0 */2 * * *

# Каждые 15 минут с 8:00 до 18:00:
*/15 8-18 * * *

# Каждые 5 минут с 9:00 до 17:00 в будние дни:
*/5 9-17 * * 1-5

# В 06:00 и 18:00:
0 6,18 * * *

# В будние дни в 09:00:
0 9 * * 1-5

# Каждый последний день месяца в 23:00:
0 23 L * *

# Каждая последняя пятница месяца в 17:00:
0 17 * * 5L

# 15-го числа каждого месяца, если это рабочий день:
0 0 15W * *

# Каждый месяц с января по июнь в 04:00:
0 4 * 1-6 *

# Каждую минуту с 9:00 до 9:05:
0-5 9 * * *


